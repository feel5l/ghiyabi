# Copy to .env.supabase (gitignored) and fill in. Then:
#   set -a && source .env.supabase && set +a && ./scripts/deploy-notify-whatsapp.sh
#
# Or export these variables in your shell before running the script.

# Supabase — Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Personal access token: https://supabase.com/dashboard/account/tokens
# (or run `supabase login` instead)
SUPABASE_ACCESS_TOKEN=

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional — default Graph API version is set in the function if omitted
# WHATSAPP_GRAPH_API_VERSION=v21.0

# Optional — required only if you call the function via Database Webhook with Bearer auth
# NOTIFY_WEBHOOK_SECRET=
